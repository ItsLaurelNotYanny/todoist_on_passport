# Relocatable CMake configuration file for bb10_tls package
@PACKAGE_INIT@

if(NOT TARGET bb10_tls::bb10_tls)
    add_library(bb10_tls::bb10_tls STATIC IMPORTED)

    set_target_properties(bb10_tls::bb10_tls PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libbb10_tls.a"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
    )

    set(_bb10_tls_deps
        "${PACKAGE_PREFIX_DIR}/lib/libssl.a"
        "${PACKAGE_PREFIX_DIR}/lib/libcrypto.a"
    )

    set(_bb10_tls_is_bb10 "@BB10_TLS_IS_BB10@")
    if(_bb10_tls_is_bb10 OR QNXNTO OR CMAKE_SYSTEM_NAME STREQUAL "QNX")
        list(APPEND _bb10_tls_deps cpp socket m)
    else()
        list(APPEND _bb10_tls_deps stdc++ pthread ${CMAKE_DL_LIBS} m)
    endif()

    set_target_properties(bb10_tls::bb10_tls PROPERTIES
        IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
        INTERFACE_LINK_LIBRARIES "${_bb10_tls_deps}"
    )

    if((DEFINED CMAKE_CXX_COMPILER_ID AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang") OR
       (DEFINED CMAKE_C_COMPILER_ID AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang"))
        set_target_properties(bb10_tls::bb10_tls PROPERTIES
            INTERFACE_LINK_OPTIONS "-Wl,--exclude-libs,ALL"
        )
    endif()
endif()

check_required_components(bb10_tls)
